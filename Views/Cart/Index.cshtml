@model List<Filmothèque.Models.CartItem>

@{
    ViewData["Title"] = "Mon Panier";
}

<h2 class="fw-bold mb-4">Votre Panier</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Votre panier est vide. <a asp-controller="Films" asp-action="Index" class="alert-link">Parcourir le catalogue</a>.
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Film</th>
                                <th>Prix</th>
                                <th>Quantité</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ImageUrl" style="width: 50px; height: 75px; object-fit: cover;" class="rounded" />
                                            <span class="fw-bold">@item.Title</span>
                                        </div>
                                    </td>
                                    <td>@item.Price.ToString("C")</td>
                                    <td>@item.Quantity</td>
                                    <td class="fw-bold">@item.Total.ToString("C")</td>
                                    <td>
                                        <form asp-action="RemoveFromCart" method="post">
                                            <input type="hidden" name="filmId" value="@item.FilmId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 p-4">
                <h4 class="fw-bold mb-3">Récapitulatif</h4>
                <div class="d-flex justify-content-between fs-5 mb-3">
                    <span>Total à payer :</span>
                    <strong class="text-success">@(((decimal)ViewBag.Total).ToString("C"))</strong>
                </div>
                <!-- Le bouton vers la validation Stripe sera ici à l'Étape 2 -->
                <a asp-controller="Checkout" asp-action="CreateCheckoutSession" class="btn btn-success btn-lg w-100">
                    Procéder au paiement
                </a>
            </div>
        </div>
    </div>
}